{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rudwpahs/running-audio/docs/schemas/pr1_board_sweep_run.schema.json",
  "title": "PR1 SX1280 board sweep run metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "gap_us",
    "target_packets",
    "phase",
    "firmware_sha",
    "frozen_baseline",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "gap_us": {
      "type": "integer",
      "enum": [5000, 1000, 500, 300, 250, 225, 200, 175, 150, 125, 0]
    },
    "target_packets": {"type": "integer", "minimum": 1},
    "phase": {"type": "string", "enum": ["baseline", "revalidate"]},
    "firmware_sha": {"type": "string", "minLength": 1},
    "frozen_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_mhz",
        "bitrate_kbps",
        "coding_rate",
        "output_dbm",
        "packet_bytes",
        "sx1280_spi_hz",
        "adaptive_layers"
      ],
      "properties": {
        "frequency_mhz": {"const": 2404.0},
        "bitrate_kbps": {"const": 1300},
        "coding_rate": {"const": 3},
        "output_dbm": {"const": 0},
        "packet_bytes": {"const": 116},
        "sx1280_spi_hz": {"const": 2000000},
        "adaptive_layers": {"const": false}
      }
    },
    "files": {
      "type": "object",
      "required": ["rx_log", "tx_log"],
      "properties": {
        "rx_log": {"type": "string", "minLength": 1},
        "tx_log": {"type": "string", "minLength": 1}
      }
    },
    "notes": {"type": "string"}
  }
}
