{
  "schema_version": 1,
  "format": "csv",
  "delimiter": ",",
  "description": "Stable flat result contract for PR1 SX1280 frozen-baseline sweep runs.",
  "columns": [
    {"name":"run_id","type":"string","nullable":false},
    {"name":"phase","type":"string","nullable":false},
    {"name":"gap_us","type":"integer","unit":"us","nullable":false},
    {"name":"target_packets","type":"integer","nullable":false},
    {"name":"packet_count","type":"integer","nullable":false},
    {"name":"missing","type":"integer","nullable":false},
    {"name":"loss_rate","type":"number","nullable":false},
    {"name":"crc_good","type":"integer","nullable":false},
    {"name":"crc_bad","type":"integer","nullable":false},
    {"name":"crc_bad_rate","type":"number","nullable":false},
    {"name":"rssi_dbm","type":"integer","unit":"dBm","nullable":false},
    {"name":"queue_depth","type":"integer","nullable":false},
    {"name":"max_queue_depth","type":"integer","nullable":false},
    {"name":"scheduler_misses","type":"integer","nullable":false},
    {"name":"irq_to_spi_us_p99","type":"integer","unit":"us","nullable":false},
    {"name":"spi_duration_us_p99","type":"integer","unit":"us","nullable":false},
    {"name":"rx_processing_us_p99","type":"integer","unit":"us","nullable":false},
    {"name":"spi_end_to_rearm_start_us_p99","type":"integer","unit":"us","nullable":false},
    {"name":"rx_rearm_us_p99","type":"integer","unit":"us","nullable":false},
    {"name":"irq_to_rx_ready_us_p99","type":"integer","unit":"us","nullable":false},
    {"name":"trace_overwrites","type":"integer","nullable":true},
    {"name":"bottleneck","type":"string","nullable":false},
    {"name":"confidence","type":"string","nullable":false},
    {"name":"revalidate_10000","type":"boolean","nullable":false}
  ],
  "required_metrics": [
    "packet_count",
    "missing",
    "crc_good",
    "crc_bad",
    "rssi_dbm",
    "queue_depth",
    "max_queue_depth",
    "scheduler_misses",
    "irq_to_spi_us_p99",
    "spi_duration_us_p99",
    "rx_processing_us_p99",
    "spi_end_to_rearm_start_us_p99",
    "rx_rearm_us_p99",
    "irq_to_rx_ready_us_p99"
  ],
  "packet_count_semantics": "RX-observed sequence span = crc_good + missing; crc_bad may overlap missing and is not additive."
}
